# RedAlpha Games — static site
# Works on Hostinger (Apache / LiteSpeed). Everything below degrades
# gracefully: if a module is unavailable the site still serves normally.

# ---- Custom error page -----------------------------------------------------
ErrorDocument 404 /404.html

# ---- Default document ------------------------------------------------------
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS (recommended once your Hostinger SSL certificate is active).
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Optional: allow clean URLs without the .html extension
  # (e.g. /privacy-policy instead of /privacy-policy.html).
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^([^\.]+)$ $1.html [NC,L]
</IfModule>

# ---- Caching for static assets --------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# ---- Light security headers ------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
